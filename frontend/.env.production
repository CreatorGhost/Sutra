# Production build config — Vite loads this ONLY for `vite build` (production mode); dev keeps the
# localhost fallback. Public URLs (not secrets), safe to commit. The prod app talks to the
# Rekvon-hosted Sutra backend over HTTPS.
VITE_API_URL=https://api.rekvon.in
VITE_PROXY_URL=https://proxy.rekvon.in
