# Frontend (Vite) config. Copy to frontend/.env and fill in for a non-dev build.
# Vite only reads env files from THIS directory (frontend/), and only inlines VITE_*-prefixed
# vars into the client bundle. Unset => the app falls back to localhost (fine for USB dev; a
# production build MUST set these or it will silently point at localhost).

VITE_PROXY_URL=          # AI proxy base, e.g. https://proxy.your-domain.com ; dev default http://localhost:8787
VITE_API_URL=            # Tier B control plane base for /auth + /sync, e.g. https://api.your-domain.com ; dev default http://localhost:8000
VITE_PROXY_SECRET=       # must equal backend PROXY_SHARED_SECRET; empty => no X-Sutra-Secret header sent
