{
  "$schema": "https://raw.githubusercontent.com/electron-userland/electron-builder/master/packages/app-builder-lib/scheme.json",
  "appId": "app.sutra.desktop",
  "productName": "Sutra",
  "directories": {
    "output": "release",
    "buildResources": "build"
  },
  "files": [
    "out/**/*",
    "node_modules/better-sqlite3-multiple-ciphers/**/*",
    "node_modules/bindings/**/*",
    "node_modules/file-uri-to-path/**/*"
  ],
  "asarUnpack": [
    "**/node_modules/better-sqlite3-multiple-ciphers/**/*.node",
    "**/node_modules/sherpa-onnx-{darwin,win,linux}-*/**/*"
  ],
  "win": {
    "target": "nsis"
  },
  "mac": {
    "target": "dmg",
    "category": "public.app-category.productivity",
    "identity": "-",
    "hardenedRuntime": false,
    "entitlements": "build/entitlements.mac.plist",
    "entitlementsInherit": "build/entitlements.mac.plist",
    "extendInfo": {
      "NSMicrophoneUsageDescription": "Sutra records your side of the meeting so it can write your notes. Audio is never stored.",
      "NSAudioCaptureUsageDescription": "Sutra captures the meeting's audio so it can transcribe the other participants. Audio is never stored.",
      "NSAppleEventsUsageDescription": "Sutra checks your browser's open tabs for a meeting (Google Meet, Zoom, Teams) so it can offer to record. It only reads tab addresses.",
      "LSUIElement": false
    }
  },
  "linux": {
    "target": "AppImage",
    "category": "Utility"
  },
  "publish": {
    "provider": "github",
    "owner": "CreatorGhost",
    "repo": "Sutra"
  },
  "extraResources": [
    {
      "from": "electron/native",
      "to": "native",
      "filter": [
        "micwatch",
        "micwatch.swift"
      ]
    },
    {
      "from": "../mcp-server/dist",
      "to": "mcp-server",
      "filter": [
        "sutra-mcp.cjs"
      ]
    }
  ]
}
