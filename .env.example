# ============================ Sutra configuration ============================
# Copy to .env and fill in secrets. Everything here is swappable.

# ---- OpenAI ----
OPENAI_API_KEY=sk-REPLACE_ME
OPENAI_BASE_URL=https://api.openai.com/v1
AI_PROVIDER=openai                       # openai | mock  (mock needs no key; used by tests/demo)
MODEL_TRANSCRIBE=gpt-4o-transcribe-diarize
MODEL_TRANSCRIBE_FALLBACK=whisper-1
MODEL_EXTRACT=gpt-5.4-mini               # structured-output extraction (corrected: GPT-4o is legacy)
MODEL_RERANK=gpt-5.4-nano                # cheap LLM rerank (when RERANK=llm)
MODEL_EMBED=text-embedding-3-large
EMBED_DIMS=1536                          # reduce 3072->1536 so pgvector HNSW can index it

# ---- Speech-to-text provider (pluggable & swappable) ----
# Routes ONLY /transcribe; chat/extract/embed/rerank always stay on OpenAI. Flip STT_PROVIDER
# (env or the runtime-settings DB row, live) to switch the STT engine — every provider returns
# the same {text,duration,segments[]} contract so nothing downstream changes.
STT_PROVIDER=deepgram                    # openai | deepgram | sarvam | mock (swap live, no redeploy)
# Deepgram (Nova-3): language=multi handles Hindi/English code-switching. Transcribes in-language
# (no native translate — Hindi->English stays a downstream step). Diarization is a paid add-on.
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3
DEEPGRAM_LANGUAGE=multi                   # multi (code-switch) | hi | en | ...
DEEPGRAM_DIARIZE=true
# Sarvam (Saaras v3): mode=translate gives Hindi->English in one call. NOTE: the sync endpoint
# caps at ~30s and does NOT diarize; long files + diarization need Sarvam's async Batch API (TODO).
SARVAM_API_KEY=
SARVAM_MODEL=saaras:v3
SARVAM_MODE=translate                     # transcribe | translate | codemix | verbatim | translit
SARVAM_LANGUAGE=unknown                   # unknown = auto-detect; or hi-IN, en-IN, ...

# ---- Database ----
DATABASE_URL=postgresql://sutra:sutra@db:5432/sutra

# ---- Capture / conversation windows ----
WINDOW_MAX_SECONDS=300                    # diarize one call per ~2-5 min window (labels stable within a call)
WINDOW_MIN_SECONDS=2

# ---- Speaker identity (voiceprint) ----
SPEAKER_ID_MODE=voiceprint                # voiceprint | manual | off
VOICEPRINT_MODEL=speechbrain/spkrec-ecapa-voxceleb
VOICEPRINT_ACCEPT=0.75                    # cosine >= accept  -> same enrolled person
VOICEPRINT_NEW=0.65                       # cosine <  new     -> unknown/new speaker

# ---- Consent mode (privacy) ----
CONSENT_MODE=off                          # off | drop | redact   (handling of unknown speakers)

# ---- Conversation segmentation ----
SEGMENT_GAP_SECONDS=300                    # silence gap that starts a new conversation
SEGMENT_TOPIC_SHIFT=on                     # also split on detected topic shift

# ---- Retrieval / ranking (see README ranking formula) ----
RANK_W_RRF=1.0
RANK_W_IMPORTANCE=0.5
RANK_HALF_LIFE_DAYS=30
RANK_RRF_K=60
RANK_RECENCY=on
RERANK=off                                 # off | crossencoder | llm
RERANK_MODEL=BAAI/bge-reranker-base
SEARCH_PREFETCH=30                         # candidates pulled per leg before fusion
SEARCH_TOPN=10

# ---- Entity resolution ----
ENTITY_SIM_THRESHOLD=0.86                  # cosine above which two same-type entities are merged

# ---- Daily recap email (SMTP) ----
RECAP_ENABLED=true
RECAP_TO=                                  # recipient for the emailed daily recap (leave blank to disable)
RECAP_TIME=08:00
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Sutra <sutra@localhost>
SMTP_TLS=starttls                          # starttls | ssl | none

# ---- App ----
APP_TIMEZONE=Asia/Kolkata
CORS_ORIGINS=http://localhost:5173,http://localhost:8000,http://localhost,capacitor://localhost
LOG_LEVEL=info
RETENTION_DAYS=0                           # 0 = keep forever; >0 prunes transcripts older than N days
SECRET_NOTE=Audio is NEVER persisted; transcripts + derived data only.

# ---- Proxy hardening (OPTIONAL — leave empty for USB/dev; behaves exactly like today) ----
PROXY_SHARED_SECRET=                        # set when hosting/LAN: phone must send matching X-Sutra-Secret
PROXY_ALLOWED_ORIGINS=                      # comma-separated CORS allowlist; empty => permissive "*"
MAX_UPLOAD_MB=30                            # /transcribe audio upload cap; oversized => HTTP 413
# Per-user proxy auth: when SUTRA_JWT_SECRET (below) is set, the proxy also accepts
# `Authorization: Bearer <user JWT>` on every call, meters usage per user (usage_events) and
# enforces plan caps (402 quota_exceeded at the testing-plan abuse ceiling). This transition flag
# keeps the legacy X-Sutra-Secret working for old APKs; flip to false after the account cutover.
PROXY_ACCEPT_SHARED_SECRET=true

# ---- Tier B (hosted, authenticated, multi-tenant memory + MCP) — OPTIONAL, OPT-IN ----
# Leave SUTRA_JWT_SECRET empty to keep the single-tenant server variant: /auth and /sync return 503,
# and the hosted MCP at /mcp default-denies every tool (no token can be minted/validated).
# Set it (a long random string) to enable accounts: signup/login -> JWT, POST /sync, and the per-user
# hosted MCP at /mcp/ (Streamable HTTP). The MCP client sends the same bearer JWT as /sync; every tool
# is scoped to that user's rows — user A's token can never read user B's memory.
SUTRA_JWT_SECRET=                           # HS256 signing secret; REQUIRED to enable Tier B accounts + MCP
SUTRA_JWT_TTL_MINUTES=10080                 # access-token lifetime (default 7 days for the test phase)

# ---- Tier B P3: OAuth 2.1 connector (one-click "custom connector" for /mcp) ----
# Public origin this server is reachable at (NO trailing slash). Used to build the OAuth discovery
# documents (/.well-known/oauth-*) and the authorize/token/redirect URLs. Localhost is fine for dev;
# a remote connector (e.g. Claude.ai web) needs a PUBLIC https origin here.
SUTRA_PUBLIC_URL=http://localhost:8000

# ---- Tier B P3: Social sign-in (Google / Facebook) — OPTIONAL, env-gated ----
# Leave blank to keep email+password only: /auth/providers reports google/facebook=false and the
# social endpoints 501. Set BOTH id+secret for a provider to enable its "Continue with ..." button.
# NOTE: these can only be live-tested once you create real OAuth apps in the Google/Facebook consoles
# (redirect URI = <SUTRA_PUBLIC_URL>/auth/oauth/{google|facebook}/callback). Nothing else depends on them.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# ---- Frontend (Vite) ----
# NOTE: Vite reads env from the frontend/ dir, NOT this repo-root file. Put the VITE_* vars in
# frontend/.env (see frontend/.env.example). Setting them here has NO effect on the build.
