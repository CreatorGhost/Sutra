# ============================ Sutra configuration ============================
# Copy to .env and fill in secrets. Everything here is swappable.

# ---- OpenAI ----
OPENAI_API_KEY=sk-REPLACE_ME
OPENAI_BASE_URL=https://api.openai.com/v1
AI_PROVIDER=openai                       # openai | mock  (mock needs no key; used by tests/demo)
MODEL_TRANSCRIBE=gpt-4o-transcribe-diarize
MODEL_TRANSCRIBE_FALLBACK=whisper-1
MODEL_EXTRACT=gpt-5.4-mini               # structured-output extraction (corrected: GPT-4o is legacy)
MODEL_RERANK=gpt-5.4-nano                # cheap LLM rerank (when RERANK=llm)
MODEL_EMBED=text-embedding-3-large
EMBED_DIMS=1536                          # reduce 3072->1536 so pgvector HNSW can index it

# ---- Database ----
DATABASE_URL=postgresql://sutra:sutra@db:5432/sutra

# ---- Capture / conversation windows ----
WINDOW_MAX_SECONDS=300                    # diarize one call per ~2-5 min window (labels stable within a call)
WINDOW_MIN_SECONDS=2

# ---- Speaker identity (voiceprint) ----
SPEAKER_ID_MODE=voiceprint                # voiceprint | manual | off
VOICEPRINT_MODEL=speechbrain/spkrec-ecapa-voxceleb
VOICEPRINT_ACCEPT=0.75                    # cosine >= accept  -> same enrolled person
VOICEPRINT_NEW=0.65                       # cosine <  new     -> unknown/new speaker

# ---- Consent mode (privacy) ----
CONSENT_MODE=off                          # off | drop | redact   (handling of unknown speakers)

# ---- Conversation segmentation ----
SEGMENT_GAP_SECONDS=300                    # silence gap that starts a new conversation
SEGMENT_TOPIC_SHIFT=on                     # also split on detected topic shift

# ---- Retrieval / ranking (see README ranking formula) ----
RANK_W_RRF=1.0
RANK_W_IMPORTANCE=0.5
RANK_HALF_LIFE_DAYS=30
RANK_RRF_K=60
RANK_RECENCY=on
RERANK=off                                 # off | crossencoder | llm
RERANK_MODEL=BAAI/bge-reranker-base
SEARCH_PREFETCH=30                         # candidates pulled per leg before fusion
SEARCH_TOPN=10

# ---- Entity resolution ----
ENTITY_SIM_THRESHOLD=0.86                  # cosine above which two same-type entities are merged

# ---- Daily recap email (SMTP) ----
RECAP_ENABLED=true
RECAP_TO=adityapratap2307@gmail.com
RECAP_TIME=08:00
RECAP_TIMEZONE=Asia/Kolkata
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Sutra <sutra@localhost>
SMTP_TLS=starttls                          # starttls | ssl | none

# ---- App ----
APP_TIMEZONE=Asia/Kolkata
CORS_ORIGINS=http://localhost:5173,http://localhost:8000
LOG_LEVEL=info
RETENTION_DAYS=0                           # 0 = keep forever; >0 prunes transcripts older than N days
SECRET_NOTE=Audio is NEVER persisted; transcripts + derived data only.
