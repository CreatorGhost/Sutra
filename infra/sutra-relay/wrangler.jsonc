{
  // Sutra relay: deploy to your own Cloudflare account (see docs/RELAY.md), then set the host secret
  // with `npx wrangler secret put HOST_SECRET`.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sutra-relay",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "durable_objects": {
    "bindings": [{ "name": "RELAY", "class_name": "SutraRelay" }]
  },
  // SQLite-backed Durable Objects are the ones on Cloudflare's free plan.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["SutraRelay"] }]
}
