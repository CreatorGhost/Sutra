# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Node
node_modules/
dist/
dist-ssr/
*.local
.vite/

# electron-builder buildResources (icons/entitlements) — keep tracked despite a global `build/` ignore.
!frontend/build/
!frontend/build/**

# Env & secrets
.env
.env.*
!.env.example

# Models / caches (downloaded at runtime)
backend/.cache/
pretrained_models/

# OS
.DS_Store

# Test artifacts
/test-results/
/playwright-report/
artifacts/
*.log

# Audio must never be committed (and is never persisted anyway)
*.wav
*.m4a
*.webm
*.mp3

# TypeScript incremental build info
*.tsbuildinfo

# Tool caches / benchmarks
.benchmarks/
.playwright-mcp/
.impeccable/
graphify-out/

# Electron build output (compiled from electron/ + renderer)
frontend/out/

# Stray wasm backups (the tracked sql-wasm.wasm is the FTS5 build)
*.sql-wasm-fts5-backup.wasm

# Editor
.vscode/

# Claude Code local settings
.claude/settings.local.json

# Local scratch screenshots / device photos (kept out of the repo root)
screenshots/
/*.png
/*.jpeg
/*.jpg
