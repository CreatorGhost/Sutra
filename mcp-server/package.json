{
  "name": "sutra-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Read-only MCP server exposing your Sutra memory to AI tools you run locally.",
  "bin": {
    "sutra-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc && npm run bundle",
    "bundle": "esbuild src/index.ts --bundle --platform=node --target=node20 --format=cjs --external:bufferutil --external:utf-8-validate --outfile=dist/sutra-mcp.cjs --log-level=warning",
    "dev": "tsx src/index.ts",
    "test": "tsx test/relay.ts",
    "e2e": "tsx test/e2e.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "ws": "^8.21.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/ws": "^8.5.13",
    "esbuild": "^0.28.0",
    "tsx": "^4.19.0",
    "typescript": "~5.9.0"
  }
}
